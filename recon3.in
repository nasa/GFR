&input
!!!dump_memory_usage = T
!!!check_flux_point_coordinates = T
grid_format = 4 !Take CGNS grid.
gridfile = "P2.cgns"
grid_scaling_factor = 0.0254

continuous_output = F
postproc_debug_grid = F

all_orders = 2
all_points = 1 ! 1-Gauss, 2-Lobatto
e_order = 2

! CORRECTION FUNCTION
!correction_function = 1 ! gDG (DEFAULT)
 correction_function = 2 ! g2
!correction_function = 3 ! gGauss

! UPWIND FLUX
 invs_flux_method = 1 ! Roe flux with Entropy fix (DEFAULT)
!invs_flux_method = 2 ! HLLC
!invs_flux_method = 3 ! LDFSS

! VISCOUS FLUX METHOD
!visc_flux_method = 1 ! BR1
 visc_flux_method = 2 ! BR2 (DEFAULT)
!visc_flux_method = 3 ! LDG

! FILTER OPTIONS
!Filter_Option = 0 ! Filter based on tensor product of 1D filter
 Filter_Option = 1 ! Filter based on polynomial degree of nr*P
 Filter_Order = 16
 Filter_Alpha = 18.0
 Filter_etac = 0.75
!Filter_eps = 0.0

governing_equations = 2
num_ts = 2000000
Timestep_Type = 1 !CFL condition
!cfl_beg = 0.1
!cfl_end = 0.75
!cfl_cycles = 10000
CFL = 0.75

!Flow reference conditions:
machref = 0.05
gam = 1.4
tref = 293.15
pref = 101325.0

!Timing information:
restart_interval = 5000
irestart = 1
output_interval = 25000
results_interval = 10000
iter_out_interval = 100

convergence_order_max_res = -12.0

itestcase = 1

use_bc_conflicts = F
sub_inflow_method = 1

bc_input(1)%name = "INFLOWSUBSONIC"
bc_input(1)%p_static = 101325.0
bc_input(1)%p_total = 121286.025
bc_input(1)%t_total = 293.15
bc_input(1)%relax%time = 0.05

/
