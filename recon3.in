!
! grid_format = 1 -> Patran Neutral (not working)
! grid_format = 2 -> Gambit Neutral
! grid_format = 3 -> GMSH (not working)
!
! flux_divergence = 0 -> Over-integration, LP, exchange only values at flux pts
! flux_divergence = 1 -> Lagrange Polynomial
! flux_divergence = 2 -> Chain rule using conserved variables
! flux_divergence = 3 -> Chain rule using jacobian
! flux_divergence = 4 -> DG method using weak formulation
! flux_divergence = 5 -> DG method using strong formulation
!
! iop_correction  = 1 -> interp primitive variables to interface to correct fluxes
! iop_correction  = 2 -> interp conservative variables to interface to correct fluxes
! iop_correction  = 3 -> interp fluxes at solution points to interface to correct fluxes
!
! For iop_solpts or iop_fluxpts or iop_qdtpts:
!     = 1 -> Gauss points
!     = 2 -> Gauss-Lobatto points
!     = 3 -> Chebyshev points (not working)
!     = 4 -> Chebyshev-Lobatto points (not working)
!
! iRKtype = 1 -> Classic 'num_stage'-stage RK
! iRKtype = 2 -> 2-stage/2nd-order SSP RK
! iRKtype = 3 -> 3-stage/3rd-order SSP RK
! iRKtype = 4 -> 5-stage/4th-order SSP RK
! iRKtype = 5 -> 5-stage/4th-order low-storage Carpenter-Kennedy RK
!
! iop_tripts = 1 -> Alpha optimized Lobatto nodes
! iop_tripts = 2 -> HT 1D Lobatto nodes projected to triangle coordinates
!
! Flux_Method = 1 -> Roe Flux with entropy fix
! Flux_Method = 2 -> HLLC
! Flux_Method = 3 -> LDFSS
!
! visc_flux_method = 1 -> BR1 and possibly LDG using LDG_beta and LDG_tau parameters
! visc_flux_method = 2 -> BR2
!
! init_loc =  0 -> init. sol. computed on solution points (SP)
! init_loc =  1 -> init. sol. computed on Gauss   pts (GP) then projected to SP
! init_loc =  2 -> init. sol. computed on Lobatto pts (LP) then projected to SP
! init_loc = -1 -> init. sol. computed on Radau   pts (RP) then projected to SP
!
! error_loc =  0 -> exact sol. on SP with weights on SP
! error_loc =  1 -> exact sol. on GP, proj. numerical to GP, weights on GP
! error_loc = -1 -> exact sol. on RP, proj. numerical to RP, weights on RP
