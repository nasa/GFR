&INPUT

grid_format = 2
gridfile = '/home/sspiegel/grid_files/cylinder/hiocfd/cylinder_coarse.symmetry.msh'

all_orders = 3
all_points = 1 ! 1-Gauss, 2-Lobatto
e_order = 3

! CORRECTION FUNCTION
 correction_function = 1 ! gDG (DEFAULT)
!correction_function = 2 ! g2
!correction_function = 3 ! gGauss

! UPWIND FLUX
 invs_flux_method = 1 ! Roe flux with Entropy fix (DEFAULT)
!invs_flux_method = 2 ! HLLC
!invs_flux_method = 3 ! LDFSS

! VISCOUS FLUX METHOD
!visc_flux_method = 1 ! BR1
 visc_flux_method = 2 ! BR2 (DEFAULT)
!visc_flux_method = 3 ! LDG

! FILTER OPTIONS
!Filter_Option = 0 ! No filter
 Filter_Option = 1 ! Filter based on tensor product of 1D filter
!Filter_Option = 2 ! Filter based on polynomial degree of nr*P
Filter_Order = 16
Filter_Alpha = 18.0
Filter_etac = 0.8
!Filter_eps = 0.0

Limiter_Option = 2

governing_equations = 2
num_ts = 1000000
Timestep_Type = 1 ! Global CFL condition
cfl_beg = 2.0
cfl_end = 2.0
cfl_cycles = 0
CFL = 2.0
Final_Time = 100.0

!Flow reference conditions:
machref = 0.3
reyref = 3900
gam = 1.4
tref = 293.15
pref = 101325.0

!Timing information:
restart_interval = 1000
output_interval = 1000
results_interval = 100000
iter_out_interval = 1

restart_output_uses_host_roots = T

output_time_averaging = T

! Restart information:
irestart = 1
restart_file  = 'Restart_files/out.current.rst'
time_ave_file = 'Restart_files/out.current.ave'

convergence_order_max_res = -12.0

itestcase = 12 ! initialize to infinite cylinder test case

use_bc_conflicts = F

/
