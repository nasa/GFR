&INPUT

PROFILE_IO_ALL = T
PROFILE_IO_CGNS_SUBS = T

GRID_FORMAT = 2    ! Gmsh file format
GRIDFILE = '../grid_files/cylinder.P3.msh'

ALL_ORDERS = 3 ! P3 solution, 4th order accuracy
ALL_POINTS = 1 ! Legendre-Gauss points

! Filter options (this filter is applied to ALL cells)
!FILTER_OPTION = 1 ! Filter based on tensor product of 1D filter
!FILTER_ORDER = 8
!FILTER_ALPHA = 36.0
!FILTER_ETAC = 0.2

! Limiter options (this limiter filter is only applied to troubled cells)
LIMITER_OPTION = 1
LIMITER_FILTER_OPTION = 1
LIMITER_FILTER_ORDER = 8
LIMITER_FILTER_ALPHA = 36.0
LIMITER_FILTER_ETAC = 0.4

LIMITER_MARKER_MIN = -2.5
LIMITER_MARKER_MAX = -0.5

GOVERNING_EQUATIONS = 2  ! Navier-Stokes equations
NUM_TIMESTEPS = 1000000
TIMESTEP_TYPE = 1 ! Global CFL condition
FINAL_TIME = 800.0

RUNGE_KUTTA_SCHEME = 3 ! SSP3
CFL     = 3.0
CFL_BEG = 0.1
CFL_END = 3.0
CFL_CYCLES = 1000

! Flow reference conditions
MACHREF = 0.3
REYREF = 3900
GAM = 1.4
TREF = 293.15     ! K
PREF = 101325.0   ! Pa

! Timing information
RESTART_INTERVAL = 10000
OUTPUT_INTERVAL = 10000
RESULTS_INTERVAL = 10
ITER_OUT_INTERVAL = 10

! Restart information
LOAD_RESTART_FILE = F
RESTART_FILE  = 'Restart_files/out.current.rst'

! Time-averaging information
OUTPUT_TIME_AVERAGING = F
TIME_AVE_FILE = 'Restart_files/out.current.ave'
START_AVERAGING_TSTAR = 100.0

ITESTCASE = 12 ! initialize to infinite cylinder test case

OUTPUT_VORTICITY = T

/
