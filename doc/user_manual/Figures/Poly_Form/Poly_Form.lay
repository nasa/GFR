#!MC 1410
$!VarSet |LFDSFN1| = '"Poly_Form.tec"'
$!VarSet |LFDSVL1| = '"r" "zero" "p(r)" "uhat_1*psi_1" "uhat_2*psi_2" "uhat_3*psi_3" "uhat_4*psi_4" "u_1*l_1" "u_2*l_2" "u_3*l_3" "u_4*l_4"'
$!VarSet |LFDSFN2| = '"Poly_Form.tec"'
$!VarSet |LFDSVL2| = '"r" "zero" "p(r)" "uhat_1*psi_1" "uhat_2*psi_2" "uhat_3*psi_3" "uhat_4*psi_4" "u_1*l_1" "u_2*l_2" "u_3*l_3" "u_4*l_4"'
$!SetStyleBase Factory
$!GlobalPaper 
  PaperSizeInfo
    {
    Letter
      {
      Width = 8.5
      Height = 11
      LeftHardClipOffset = 0.125
      RightHardClipOffset = 0.125
      TopHardClipOffset = 0.125
      BottomHardClipOffset = 0.125
      }
    }
$!Page 
  Name = 'Untitled'
  PaperAttributes
    {
    BackgroundColor = White
    IsTransparent = Yes
    OrientPortrait = No
    ShowGrid = Yes
    ShowRuler = No
    ShowPaper = No
    PaperSize = Letter
    RulerSpacing = OneInch
    PaperGridSpacing = HalfInch
    RegionInWorkArea
      {
      X1 = 1
      Y1 = 1
      X2 = 7
      Y2 = 3
      }
    }
### Frame Number 1 ###
$!ReadDataSet  '|LFDSFN1|'
  InitialPlotType = XYLine
  IncludeText = No
  IncludeGeom = No
  ResetStyle = No
  AssignStrandIDs = Yes
  VarLoadMode = ByName
  VarNameList = '|LFDSVL1|'
$!RemoveVar |LFDSVL1|
$!RemoveVar |LFDSFN1|
$!FrameLayout 
  ShowBorder = No
  ShowHeader = No
  HeaderColor = Red
  XYPos
    {
    X = 1
    Y = 1
    }
  Width = 3
  Height = 2
$!ThreeDAxis 
  AspectRatioLimit = 25
  BoxAspectRatioLimit = 25
$!PlotType  = XYLine
$!FrameName  = 'Frame 001'
$!GlobalTime 
  SolutionTime = 0
$!DeleteLineMaps 
$!ActiveLineMaps  =  [1-6]
$!GlobalLinePlot 
  DataLabels
    {
    DistanceSkip = 5
    }
  Legend
    {
    Show = Yes
    ShowText = No
    TextShape
      {
      Height = 4.55
      }
    Box
      {
      BoxType = None
      }
    XYPos
      {
      X = 14
      Y = 96
      }
    AnchorAlignment = TopLeft
    }
$!LineMap  [1]
  Name = '&DV&'
  Assign
    {
    Zone = 1
    XAxisVar = 'r'
    YAxisVar = 'zero'
    YAxis = 2
    ShowInLegend = Never
    }
  Lines
    {
    Color = Black
    LinePattern = Dotted
    }
  Curves
    {
    CurveType = PolynomialFit
    }
  Symbols
    {
    Show = No
    SymbolShape
      {
      GeomShape = Circle
      }
    Color = Black
    FillMode = UseLineColor
    FillColor = Red
    Size = 1.5
    }
  BarCharts
    {
    Color = Red
    FillColor = Red
    }
  ErrorBars
    {
    Color = Red
    }
$!LineMap  [2]
  Name = '&DV&'
  Assign
    {
    Zone = 1
    XAxisVar = 'r'
    YAxisVar = 'p(r)'
    }
