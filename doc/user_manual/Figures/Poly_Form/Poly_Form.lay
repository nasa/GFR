$!XYLineAxis 
  DepXToYRatio = 1
  GridArea
    {
    DrawBorder = Yes
    }
  ViewportPosition
    {
    X1 = 10
    X2 = 90
    Y2 = 95
    }
  ViewportTopSnapTarget = 95
$!XYLineAxis 
  XDetail 1
    {
    CoordScale = Linear
    RangeMin = -1
    RangeMax = 1.000199999999999978
    GRSpacing = 0.5
    TickLabel
      {
      TextShape
        {
        Height = 4
        }
      Offset = 1.5
      }
    Title
      {
      TextShape
        {
        Height = 4.6
        }
      Offset = 6
      }
    }
$!XYLineAxis 
  YDetail 1
    {
    CoordScale = Linear
    RangeMin = -4
    RangeMax = 10.00140000000000029
    GRSpacing = 2
    TickLabel
      {
      TextShape
        {
        Height = 4
        }
      }
    Title
      {
      ShowOnAxisLine = No
      }
    }
$!XYLineAxis 
  YDetail 2
    {
    CoordScale = Linear
    RangeMin = -4
    RangeMax = 10
    GRSpacing = 2
    TickLabel
      {
      ShowOnAxisLine = No
      TextShape
        {
        Height = 4
        }
      }
    Title
      {
      ShowOnAxisLine = No
      }
    AxisLine
      {
      AxisAlignment = WithGridMax
      }
    }
$!LinePlotLayers 
  ShowSymbols = Yes
$!AttachText 
  AnchorPos
    {
    X = 33
    Y = 90
    }
  TextShape
    {
    SizeUnits = Frame
    Height = 4
    }
  Anchor = HeadLeft
  TextType = LaTeX
  Text = R"(\begin{align*}
p(r)                & \text{ Polynomial}\\
\hat{u}_1 \psi_1(r) & \text{ Mode 1 Term Constant}\\
\hat{u}_2 \psi_2(r) & \text{ Mode 2 Term Linear}\\
\hat{u}_3 \psi_3(r) & \text{ Mode 3 Term Quadratic}\\
\hat{u}_4 \psi_4(r) & \text{ Mode 4 Term Cubic}
\end{align*})"
