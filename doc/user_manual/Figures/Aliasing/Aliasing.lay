      NumFormat
        {
        Formatting = FixedFloat
        Precision = 1
        TimeDateFormat = ''
        }
      }
    Title
      {
      TitleMode = UseText
      Text = '<greek>x</greek>'
      TextShape
        {
        Height = 5
        }
      Offset = 8
      }
    }
$!XYLineAxis 
  YDetail 1
    {
