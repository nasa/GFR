        RowBox[{"{", "Green", "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Combine", " ", "plots", " ", "of", " ", "solution", " ", "points", " ", 
     "and", " ", 
     RowBox[{"polynomials", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
