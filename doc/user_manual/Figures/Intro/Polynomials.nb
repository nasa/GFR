Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Define", " ", "functions", " ", "for", " ", "left", " ", "and", " ", 
    "right", " ", "Radau", " ", 
    RowBox[{"polynomials", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"leftRadau", "[", 
      RowBox[{"order_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"LegendreP", "[", 
         RowBox[{"order", ",", "x"}], "]"}], "+", 
        RowBox[{"LegendreP", "[", 
         RowBox[{
          RowBox[{"order", "-", "1"}], ",", "x"}], "]"}]}], ")"}], "/", 
      "2"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rightRadau", "[", 
      RowBox[{"order_", ",", "x_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"-", "1"}], ")"}], "^", "order"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"LegendreP", "[", 
          RowBox[{"order", ",", "x"}], "]"}], "-", 
         RowBox[{"LegendreP", "[", 
          RowBox[{
           RowBox[{"order", "-", "1"}], ",", "x"}], "]"}]}], ")"}], "/", 
       "2"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Define", " ", "function", " ", "for", " ", "Lagrange", " ", 
     RowBox[{"polynomial", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Lagrange", "[", 
      RowBox[{"xpts_", ",", "ypts_", ",", "x_"}], "]"}], ":=", 
     RowBox[{"InterpolatingPolynomial", "[", 
      RowBox[{
       RowBox[{"Transpose", "@", 
        RowBox[{"{", 
         RowBox[{"xpts", ",", "ypts"}], "}"}]}], ",", "x"}], "]"}]}], 
    ";"}]}]}]], "Input",
