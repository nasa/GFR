       RowBox[{"InterpolatingPolynomial", "[", 
        RowBox[{"datafd3", ",", "x"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "1", ",", "3"}], "}"}], ",", 
