Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Create", " ", "plots", " ", "of", " ", "discontinuous", " ", "flux", " ", 
    "points", " ", "in", " ", "each", " ", 
    RowBox[{"cell", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"plotfd1p", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "Medium", "]"}], ",", "Green", ",", 
        RowBox[{"Point", "[", "datafd1", "]"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotfd2p", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "Medium", "]"}], ",", "Green", ",", 
        RowBox[{"Point", "[", "datafd2", "]"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotfd3p", "=", 
     RowBox[{"Graphics", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"PointSize", "[", "Medium", "]"}], ",", "Green", ",", 
        RowBox[{"Point", "[", "datafd3", "]"}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Create", " ", "plots", " ", "of", " ", "discontinuous", " ", "flux", " ",
      "polynomials", " ", "in", " ", "each", " ", 
     RowBox[{"cell", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotfd1", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"InterpolatingPolynomial", "[", 
        RowBox[{"datafd1", ",", "x"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"-", "3"}], ",", 
         RowBox[{"-", "1"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"{", "Green", "}"}]}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         TemplateBox[<|"boxes" -> FormBox[
             RowBox[{
               SuperscriptBox[
                StyleBox["f", "TI"], 
                StyleBox["D", "TI"]], "(", 
               StyleBox["x", "TI"], ")"}], TraditionalForm], "errors" -> {}, 
           "input" -> "f^D(x)", "state" -> "Boxes"|>,
          "TeXAssistantTemplate"], "}"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotfd2", "=", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"InterpolatingPolynomial", "[", 
        RowBox[{"datafd2", ",", "x"}], "]"}], ",", 
