$!XYLineAxis 
  DepXToYRatio = 1
  GridArea
    {
    DrawBorder = Yes
    }
  ViewportPosition
    {
    X1 = 10
    Y1 = 16
    X2 = 93
    Y2 = 93
    }
  ViewportTopSnapTarget = 93
$!XYLineAxis 
  XDetail 1
    {
    CoordScale = Linear
    RangeMin = -1
    RangeMax = 1
    GRSpacing = 0.5
    Ticks
      {
      ShowOnGridBorderMax = Yes
      }
    TickLabel
      {
      TextShape
        {
        Height = 4
        }
      Offset = 2
      }
    Title
      {
      ShowOnAxisLine = No
      TextShape
        {
        Height = 4.6
        }
      Offset = 8
      }
    }
$!XYLineAxis 
  YDetail 1
    {
    CoordScale = Linear
    RangeMin = -1.1999999999999999556
    RangeMax = 1.1999999999999999556
    GRSpacing = 0.5
    Ticks
      {
      ShowOnGridBorderMax = Yes
      }
    TickLabel
      {
      TextShape
        {
        Height = 4
        }
      NumFormat
        {
        Formatting = FixedFloat
        Precision = 1
        TimeDateFormat = ''
        }
      }
    Title
      {
      ShowOnAxisLine = No
      }
    }
