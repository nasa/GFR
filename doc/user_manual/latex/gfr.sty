% \NewDocumentCommand{\dyadprod}{}{\ensuremath{\otimes}}
  \NewDocumentCommand{\crossprod}{}{\ensuremath{\times}}

%###############################################################################
%###############################################################################
%
% The following commands are standardizing the format of simple code
% and other computer items (e.g., file names)
%
%###############################################################################
%###############################################################################

% Text size to use for Fortran logical values
\NewDocumentCommand{\logicalSize}{m}{\small{#1}}
% Fortran .TRUE.
\NewDocumentCommand{\tru}{}{{\logicalSize{\texttt{.TRUE.}}}}
% Fortran .FALSE.
\NewDocumentCommand{\fls}{}{{\logicalSize{\texttt{.FALSE.}}}}

% Format for file system paths and file names
% Must manually escape special characters!
\NewDocumentCommand{\file}{m}{\texttt{#1}}

%###############################################################################
%###############################################################################
%
% Custom paired delimiters
%
%###############################################################################
%###############################################################################

% Delimiters for the magnitude of a vector
%\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\NewDocumentCommand{\norm}{m}{\ensuremath{\left\|#1\right\|}}
% Delimiters for the absolute value
%\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\NewDocumentCommand{\abs}{m}{\ensuremath{\left|#1\right|}}

%###############################################################################
%###############################################################################
%
% Commands to make quotations uniform throughout
%
%###############################################################################
%###############################################################################

% Standard double quote in standard text font
\NewDocumentCommand{\quoterm}{m}{``#1''}
% Single quote in standard text font
\NewDocumentCommand{\quotermSingle}{m}{`#1'}
% Double quote in texttt font
\NewDocumentCommand{\quotett}{m}{\texttt{"#1"}}

%###############################################################################

\endinput
